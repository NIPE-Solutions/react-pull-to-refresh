{
  "name": "@nipe-solutions/react-pull-to-refresh",
  "version": "0.1.0-alpha.0",
  "description": "Accessible, native-feeling pull-to-refresh for React.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NIPE-Solutions/react-pull-to-refresh"
  },
  "homepage": "https://react-pull-to-refresh.nipesolutions.com",
  "bugs": {
    "url": "https://github.com/NIPE-Solutions/react-pull-to-refresh/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "alpha"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.6.0",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core.css": "./dist/core.css",
    "./theme.css": "./dist/theme.css",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "npm run build:dist && vite --config website/vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "build:dist": "vite build && dts-bundle-generator --project tsconfig.build.json --silent --no-banner -o dist/index.d.ts src/index.ts && node scripts/copy-styles.mjs",
    "build:website": "npm run build:dist && vite build --config website/vite.config.ts",
    "test:api": "node scripts/check-public-api.mjs",
    "test:size": "node scripts/check-bundle-size.mjs",
    "test:package": "npm run build:dist && node --test test/package/verify-package.test.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build:dist && npm run test:api && npm run test:size && npm run test:package && npm run build:website",
    "clean": "rm -rf dist coverage"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
